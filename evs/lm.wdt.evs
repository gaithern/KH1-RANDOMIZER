                if (bit[0x7735]) {
                    Group_display_off(3);
                    Set_attribute_off(0x64);
                } else {
                    Group_display_on(3);
                    Set_attribute_on(0x64);
                }
                if (save_data2[0x1A8] == 0x10) {
                    Set_attribute_on(0x68);
                } else {
                    Set_attribute_off(0x68);
                }
                break;
            case LM02:
                Set_attribute_off(0x66);
                break;
            case LM03:
                if (bit[0x7735]) {
                    Group_display_off(3);
                    Set_attribute_off(0x64);
                } else {
                    Group_display_on(3);
                    Set_attribute_on(0x64);
                }
                if (ATLANTICA_PROGRESS >= 0x5D) {
                    Group_display_on(4);
                    Set_attribute_on(0x65);
                } else {
                    Group_display_off(4);
                    Set_attribute_off(0x65);
                }
                break;
            case LM07:
                if (bit[0x7737]) {
                    Group_display_off(2);
                }
                Set_attribute_on(0x64);
                Set_attribute_off(0x65);
                break;
            case LM08:
                if (bit[0x7737]) {
                    Group_display_off(2);
                }
                Set_attribute_on(0x65);
                Set_attribute_off(0x64);
                break;
            case LM10:
                Change_FOG(0, 0x18, 0x12, 0x16, 0x3E8, 0xBB8, 0x46, 0xFF);
                break;
            case LM11:
                Change_FOG(0, 0x18, 0x12, 0x16, 0x3E8, 0xBB8, 0x46, 0xFF);
                break;
            case LM12:
                Change_FOG(0, 0x16, 0xC, 0x12, 0xA28, 0x1770, 0x50, 0xFF);
                break;
