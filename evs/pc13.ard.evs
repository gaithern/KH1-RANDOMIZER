            }
            bit[0x6B2E] = 1;
            bit[0x6B2F] = 0;
            Pad_ctrl_on();
            Enter_event_mode();
            runtime.dword[0x920] = 0x64;
            runtime.dword[0x924] = 0;
            Set_comm_work(0x64, 0);
        }
        main {
            if (END_OF_THE_WORLD_PROGRESS >= 1) {
                Fade_out(0);
                All_char_ctrl_off();
                Change_BGM_volume(1, 0, 0x28);
                Change_BGM_volume(2, 0, 0x28);
                Set_wait_timer(0x28);
                Stop_BGM();
                runtime.dword[0x928] = Get_event_skip_flag(0x41);
                if (runtime.dword[0x928] == 1) {
                    start(thread_12.entry_11, level=6);
                    Set_wait_timer(1);
                    await(thread_12.entry_11, level=6);
                    Set_wait_timer(1);
                }
                Pad_ctrl_off();
                if (runtime.dword[0x92C] == 0) {
                    start(thread_1.entry_11, level=6);
                    goto L1;
                }
                start(thread_1.entry_12, level=6);
            L1:
                if (0 == runtime.dword[0x924]) {
                    runtime.dword[0x924] = Get_comm_Num();
                    goto L1;
                }
                Pad_ctrl_off();
                All_char_ctrl_off();
                start(thread_1.entry_13, level=6);
                goto L2;
            }
            Get_camera_info();
            Set_wait_timer(4);
            Fade_in(8);
            Set_wait_timer(6);
            Command_display_on();
            Gauge_on();
            Pad_ctrl_on();
            All_char_ctrl_on();
            Remove_invincibility();
            Exit_event_mode();
            DIALOG_STATE = 0;
            Enable_all_battle_event_boxes();
        L2:
            if (1) {
                goto L2;
            }
        }
    }

