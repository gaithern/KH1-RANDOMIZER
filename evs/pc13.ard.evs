        }
        main {
            switch (HOLLOW_BASTION_PROGRESS) {
            case 0x5A:
                Fade_out(0);
                All_char_ctrl_off();
                Change_BGM_volume(1, 0, 0x28);
                Change_BGM_volume(2, 0, 0x28);
                Set_wait_timer(0x28);
                Stop_BGM();
                runtime.dword[0x920] = Get_event_skip_flag(0x3E);
                if (runtime.dword[0x920] == 1) {
                    start(thread_12.entry_11, level=6);
                    Set_wait_timer(1);
                    await(thread_12.entry_11, level=6);
                    Set_wait_timer(1);
                }
                Pad_ctrl_off();
                if (runtime.dword[0x924] == 0) {
                    start(thread_1.entry_11, level=6);
                    goto L1;
                }
                start(thread_1.entry_12, level=6);
            L1:
                if (0 == runtime.dword[0x91C]) {
                    runtime.dword[0x91C] = Get_comm_Num();
                    goto L1;
                }
                Wait_limit_skill_end();
                Wait_summon_end();
                Wait_battle_icon_display();
                Pad_ctrl_off();
                All_char_ctrl_off();
                start(thread_1.entry_13, level=6);
                break;
            default:
                Get_camera_info();
                Set_wait_timer(4);
                Fade_in(8);
                Set_wait_timer(6);
                Command_display_on();
                Gauge_on();
                Pad_ctrl_on();
                All_char_ctrl_on();
                Remove_invincibility();
                Exit_event_mode();
                DIALOG_STATE = 0;
                Enable_all_battle_event_boxes();
            }
            while (1) {
            }
        }
    }

