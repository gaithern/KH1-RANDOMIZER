            Start_effect(0);
            Set_wait_timer(1);
            Set_loaded_effect_location(0, Push_actor_coord_X(mo_trinity_w1), Push_actor_coord_Y(mo_trinity_w1) - 0xA0, Push_actor_coord_Z(mo_trinity_w1));
            await(sora.entry_29, level=6);
            await(player1.entry_29, level=6);
            await(player2.entry_29, level=6);
            Start_effect(1);
            Set_wait_timer(1);
            Set_loaded_effect_location(1, Push_actor_coord_X(mo_trinity_w1), Push_actor_coord_Y(mo_trinity_w1), Push_actor_coord_Z(mo_trinity_w1));
            Change_effect_scale(1, 0x96, 0x64, 0x96);
            Set_wait_timer(0x1E);
            Hide_char();
            start(thread_8.entry_11, level=6);
            await(thread_8.entry_11, level=6);
            White_out(0x13);
            Set_wait_timer(0x14);
            Clear_event_effect();
            start(sora.entry_30, level=6);
            start(player1.entry_30, level=6);
            start(player2.entry_30, level=6);
            await(sora.entry_30, level=6);
            await(player1.entry_30, level=6);
            await(player2.entry_30, level=6);
            Set_wait_timer(1);
            Event_camera_off();
            Set_wait_timer(3);
            White_in(0xA);
            Set_wait_timer(0xA);
            if (bit[0x6D82] == 0) {
                WHITE_TRINITIES_ACTIVATED = WHITE_TRINITIES_ACTIVATED + 1;
                bit[0x6D82] = 1;
            }
            bit[0x6D82] = 1;
            Make_inoperable(sora);
            Make_inoperable(player1);
            Make_inoperable(player2);
        }
    }

    thread 8 {
        main {
            while (1) {
            }
        }
        entry_11 {
            Display_model(MO_TRE_BOX5);
            Set_char_ID(MO_TRE_BOX5);
        }
    }
}
