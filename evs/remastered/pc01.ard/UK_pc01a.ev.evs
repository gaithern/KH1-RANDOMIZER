                All_char_ctrl_on();
                Remove_invincibility();
                Exit_event_mode();
                DIALOG_STATE = 0;
                Enable_all_battle_event_boxes();
                break;
            case 0x1E:
                if (save_data[0x504] == 0) {
                    Fade_out(0);
                    All_char_ctrl_off();
                    Pad_ctrl_off();
                    start(thread_1.entry_13, level=6);
                } else {
                    Get_camera_info();
                    Set_wait_timer(4);
                    Fade_in(8);
                    Set_wait_timer(6);
                    Command_display_on();
                    Gauge_on();
                    Pad_ctrl_on();
                    All_char_ctrl_on();
                    Remove_invincibility();
                    Exit_event_mode();
                    DIALOG_STATE = 0;
                    Enable_all_battle_event_boxes();
                }
                break;
            default:
                Get_camera_info();
                Set_wait_timer(4);
                Fade_in(8);
                Set_wait_timer(6);
                Command_display_on();
                Gauge_on();
                Pad_ctrl_on();
                All_char_ctrl_on();
                Remove_invincibility();
                Exit_event_mode();
                DIALOG_STATE = 0;
                Enable_all_battle_event_boxes();
            }
            while (1) {
            }
        }
    }

