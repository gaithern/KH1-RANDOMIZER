            EVENT_POSITION_X.word = 0x41A;
            EVENT_POSITION_Y.word = 1;
            EVENT_POSITION_Z.word = 0;
            start(sora.entry_28, level=6);
            start(player1.entry_28, level=6);
            start(player2.entry_28, level=6);
            Set_wait_timer(2);
            White_in(4);
            Set_wait_timer(0x7E);
            Set_camera_focus_position(0x413, -0x95, -0x11);
            Rotate_camera(0xB, 0x5A, 0);
            Set_camera_distance(0x154);
            Set_camera_fov(0x35);
            Hide_char();
            start(thread_5.entry_11, level=6);
            await(thread_5.entry_11, level=6);
            White_out(2);
            Set_wait_timer(3);
            End_effect_loop(1);
            Set_wait_timer(1);
            Clear_loaded_effect_ID(1);
            Clear_event_effect();
            Show_all_map_objects();
            start(sora.entry_31, level=6);
            await(sora.entry_31, level=6);
            start(player1.entry_31, level=6);
            await(player1.entry_31, level=6);
            start(player2.entry_31, level=6);
            await(player2.entry_31, level=6);
            Event_camera_off();
            Set_wait_timer(4);
            White_in(0xA);
            Set_wait_timer(0xA);
            if (bit[0x6D73] == 0) {
                GREEN_TRINITIES_ACTIVATED = GREEN_TRINITIES_ACTIVATED + 1;
                bit[0x6D73] = 1;
            }
            bit[0x6D73] = 1;
            Make_inoperable(sora);
            Make_inoperable(player1);
            Make_inoperable(player2);
        }
    }

    thread 5 {
        main {
            while (1) {
            }
        }
        entry_11 {
            Display_model(MO_TRE00_AW02);
            Set_char_ID(MO_TRE00_AW02);
            Char_bg_off();
            Change_char_color(0xFF, 0xFF, 0xFF, 0, 0);
            Set_char_position(0x4E2, -0x12C, 0);
            Set_wait_timer(1);
            Change_char_color(0xFF, 0xFF, 0xFF, 0x80, 0x18);
            MOVE_NOTURN(0x1E, 0x4E2, 0, 0);
            Set_wait_timer(0x1E);
            Char_bg_on();
            Restore_char_color();
            bit[0x710D] = 1;
        }
    }
}
