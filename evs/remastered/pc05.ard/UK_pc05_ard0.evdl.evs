            save_data2[0x1D] = 0;
            CURRENT_WORLD = Get_world_number();
            if ((bit[0x6B2F] == 1) | (bit[0x6B2E] == 0)) {
                DIALOG_STATE = 4;
            }
            bit[0x6B2E] = 1;
            bit[0x6B2F] = 0;
            Pad_ctrl_on();
            Enter_event_mode();
            runtime.dword[0xA18] = 0;
            runtime.dword[0xA1C] = Get_set_number();
            runtime.dword[0xA20] = 0;
            runtime.dword[0x924] = 0x64;
            runtime.dword[0x928] = 0;
            Set_comm_work(0x64, 0);
        }
        main {
            switch (HOLLOW_BASTION_PROGRESS) {
            case 0x28:
                Fade_out(0);
                All_char_ctrl_off();
                Pad_ctrl_off();
                start(thread_1.entry_11, level=6);
                while (0 == runtime.dword[0x928]) {
                    runtime.dword[0x928] = Get_comm_Num();
                }
                Wait_limit_skill_end();
                Wait_summon_end();
                Wait_battle_icon_display();
                Pad_ctrl_off();
                All_char_ctrl_off();
                Init_all_enemy_battle_scripts();
                start(thread_1.entry_12, level=6);
                break;
            case 0x32:
                Get_camera_info();
                Set_wait_timer(4);
                Fade_in(8);
                Set_wait_timer(6);
                Command_display_on();
                Gauge_on();
                Pad_ctrl_on();
                All_char_ctrl_on();
                Remove_invincibility();
                Exit_event_mode();
                DIALOG_STATE = 0;
                Enable_all_battle_event_boxes();
                while (bit[0x7FFA] == 0) {
                }
                All_char_ctrl_off();
                Pad_ctrl_off();
                Change_BGM_volume(1, 0, 0x28);
                Set_wait_timer(0x3C);
                Write_set_number_from_table(6);
                Set_wait_timer(1);
                Hold_camera_info();
                Make_operable(thread_2);
                Make_party_invincible();
                Enter_event_mode();
                Command_display_off();
                Gauge_off();
                Set_wait_timer(1);
                PREVIOUS_WORLD = Get_world_number();
                runtime[0xD00] = PREVIOUS_AREA;
                PREVIOUS_AREA = Get_area_number();
                PREVIOUS_SET = Get_set_number();
                DIALOG_STATE = 2;
                Close_window(7);
                Pad_ctrl_off();
                Enter_event_mode();
                Fade_out(0xF);
                Set_wait_timer(0xF);
                DIALOG_STATE = 3;
                bit[0x6B2F] = 1;
                bit[0x6B2E] = 1;
                Event_camera_off();
                Change_area(0x32);
                break;
            default:
                Get_camera_info();
                Set_wait_timer(4);
                Fade_in(8);
                Set_wait_timer(6);
                Command_display_on();
                Gauge_on();
                Pad_ctrl_on();
                All_char_ctrl_on();
                Remove_invincibility();
                Exit_event_mode();
                DIALOG_STATE = 0;
                Enable_all_battle_event_boxes();
            }
            while (1) {
            }
        }
    }

