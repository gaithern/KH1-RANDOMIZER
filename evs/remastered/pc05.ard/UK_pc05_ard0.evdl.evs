    thread 0 {
        init {
            switch (HOLLOW_BASTION_PROGRESS) {
            case 0x28:
                Stop_BGM();
                Quick_save_off();
                break;
            }
            Disable_all_battle_event_boxes();
            save_data2.word[0x3E0] = 0;
            save_data2.word[0x3E2] = 0;
