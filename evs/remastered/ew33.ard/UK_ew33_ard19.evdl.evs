globals {
    CURRENT_WORLD = save_data2[0x1C];
    DIALOG_STATE = save_data2[3];
    END_OF_THE_WORLD_PROGRESS = save_data[0x90F];
    EW33_SECOND_VISIT = save_data[0x141];
    SHORTEN_GO_MODE = save_data[0x4C];
}

kgr 0 {
    entities {
        SORA = 0;
        DONALD = 0x30001;
        GOOFY = 0x30002;
    }

    thread 0 {
        init {
            if (!SHORTEN_GO_MODE) goto L1;
            if (!(END_OF_THE_WORLD_PROGRESS == 0x9B)) goto L1;
            if (!(EW33_SECOND_VISIT == 0)) goto L1;
            Set_party(1, 2, -1);
        L1:
            Disable_all_battle_event_boxes();
            save_data2.word[0x3E0] = 0;
            save_data2.word[0x3E2] = 0;
            save_data2.word[0x3E4] = 0;
            save_data2.word[0x3E6] = 0;
            save_data2.word[0x3E8] = 0;
            save_data2.word[0x3EA] = 0;
            save_data2.word[0x3EC] = 0;
            save_data2.word[0x3EE] = 0;
            save_data2[0x3F0] = 0;
            save_data2[0x3F1] = 0;
            save_data2[0x3F2] = 0;
            save_data2[0x3F3] = 0;
            save_data2[0x3F4] = 0;
            save_data2[0x3F5] = 0;
            save_data2[0x3F6] = 0;
            save_data2[0x3F7] = 0;
            save_data2[0x1D] = 0;
            CURRENT_WORLD = Get_world_number();
            if ((bit[0x6B2F] == 1) | (bit[0x6B2E] == 0)) {
                DIALOG_STATE = 4;
            }
            bit[0x6B2E] = 1;
            bit[0x6B2F] = 0;
            Pad_ctrl_on();
            Enter_event_mode();
        }
        main {
            Get_camera_info();
            Set_wait_timer(4);
            Fade_in(8);
            Set_wait_timer(6);
            Command_display_on();
            Gauge_on();
            Pad_ctrl_on();
            All_char_ctrl_on();
            Remove_invincibility();
            Exit_event_mode();
            DIALOG_STATE = 0;
            Enable_all_battle_event_boxes();
            while (1) {
            }
        }
    }

    thread sora {  // 1
        init {
            Set_char_ID(SORA);
        }
        main {
            while (1) {
            }
        }
    }

    thread donald {  // 2
        init {
            Set_char_ID(DONALD);
        }
        main {
            while (1) {
            }
        }
    }

    thread goofy {  // 3
        init {
            Set_char_ID(GOOFY);
        }
        main {
            while (1) {
            }
        }
    }

    thread 4 {
        init {
            All_char_ctrl_off();
            Make_party_invincible();
        }
        main {
            while (1) {
            }
        }
    }
}
