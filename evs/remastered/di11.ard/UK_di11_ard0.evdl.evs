                    Close_window(7);
                    Open_window_no_close(7);
                    Display_message(7, messages[0x1C2]="{0x08}{0x0A}Seashore");
                    goto L2;
                }
                if (!((local18 == 0) & (local19 == 1))) goto L2;
                Close_window(7);
                DIALOG_STATE = 0;
                local19 = 0;
            L2:
                if (!(DIALOG_STATE == 3)) goto L1;
                local19 = 0;
            L1:
            }
        }
    }
}

