                Set_window_position(7, 0, 1);
                Open_window(7);
                Display_message_from_gift_table(7, GIFT_TABLE_ITEM.dword);
                Set_wait_timer(8);
                Play_SE2(0x1F, 0);
                Wait_message_end_ID(7);
                Close_window(7);
                if (DIALOG_STATE == 2) {
                    DIALOG_STATE = 3;
                }
                Trigger_event(1);
                DESTINY_ISLANDS_PROGRESS = 0x21;
