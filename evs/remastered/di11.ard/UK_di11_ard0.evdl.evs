            }
            if (runtime.dword[0x900] == 0) {
                Set_window_position(1, -0x64, -0x78);
                Set_window_size(1, 0xB, 2);
                Open_window(1);
                Display_message(1, messages[0x1AA]="{0x0B}{0x14}{0x07}{0x0C}I wonder where this door{lf}{0x0B}{0x14}leads…");
                Wait_message_end();
                runtime.dword[0x900] = 1;
                goto L1;
            }
            if (!(runtime.dword[0x900] == 1)) goto L1;
            Set_window_position(1, -0x64, -0x78);
            Set_window_size(1, 0xB, 3);
            Open_window(1);
            Display_message(1, messages[0x1AB]="{0x0B}{0x14}{0x07}{0x0C}No doorknob, no keyhole.{lf}{0x0B}{0x14}What kind of door is this,{lf}{0x0B}{0x14}anyway?");
            Wait_message_end();
            runtime.dword[0x900] = 0;
        L1:
        }
    }

    thread 5 {
