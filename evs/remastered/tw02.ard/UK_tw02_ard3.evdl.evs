                            Set_max_counter(4);
                            local0 = Get_minigame_record(0, 1);
                            Show_minigame_info(0, local0);
                            Event_camera_off();
                            Start_timer_up(0);
                        }
                        break;
                    case 0x98:
                        if ((runtime.dword[0xA2C] == 0) & (runtime.dword[0xA1C] == 0)) {
                            runtime.dword[0xA2C] = 1;
                            runtime.dword[0xA1C] = 1;
                            runtime.dword[0xA10] = Stop_timer();
                            Restart_timer();
                            Inc_counter(1);
                            runtime.dword[0xA18] = runtime.dword[0xA18] + 1;
                        }
                        break;
                    case 0x99:
                        if ((runtime.dword[0xA2C] == 0) & (runtime.dword[0xA20] == 0)) {
                            runtime.dword[0xA2C] = 1;
                            runtime.dword[0xA20] = 1;
                            runtime.dword[0xA10] = Stop_timer();
                            Restart_timer();
                            Inc_counter(1);
                            runtime.dword[0xA18] = runtime.dword[0xA18] + 1;
                        }
                        break;
                    case 0x9A:
                        if ((runtime.dword[0xA2C] == 0) & (runtime.dword[0xA24] == 0)) {
                            runtime.dword[0xA2C] = 1;
                            runtime.dword[0xA24] = 1;
                            runtime.dword[0xA10] = Stop_timer();
                            Restart_timer();
                            Inc_counter(1);
                            runtime.dword[0xA18] = runtime.dword[0xA18] + 1;
                        }
                        break;
                    case 0x9B:
                        if ((runtime.dword[0xA2C] == 0) & (runtime.dword[0xA28] == 0)) {
                            runtime.dword[0xA2C] = 1;
                            runtime.dword[0xA28] = 1;
                            runtime.dword[0xA10] = Stop_timer();
                            Restart_timer();
                            Inc_counter(1);
                            runtime.dword[0xA18] = runtime.dword[0xA18] + 1;
                        }
                        break;
                    case 0xA0:
                        if (runtime.dword[0xA30] == 0) {
                            runtime.dword[0xA30] = 1;
                            runtime.dword[0xA10] = Stop_timer();
                            Make_operable(sora);
                            Make_party_invincible();
                            Enter_event_mode();
                            Command_display_off();
                            Gauge_off();
                            Set_wait_timer(1);
                            start(thread_0.entry_11, level=5);
                            Set_wait_timer(0x28);
                            Fade_out(0xF);
                            Set_wait_timer(0xF);
                            await(thread_0.entry_11, level=5);
                            start(sora.entry_11, level=6);
                            await(sora.entry_11, level=6);
                            Set_wait_timer(5);
                            runtime.dword[0xA14] = 0;
                            Pause_timer();
                            Reset_timer(0);
                            Hide_counter();
                            Make_operable(sora);
                            Make_party_invincible();
                            Enter_event_mode();
                            Command_display_off();
                            Gauge_off();
                            Set_wait_timer(1);
                            Fade_in(0xF);
                            Set_wait_timer(0xF);
                            runtime.dword[0xA2C] = 0;
                            runtime.dword[0xA30] = 0;
                        }
                        break;
                    case 0x9C:
                        if ((runtime.dword[0xA2C] == 0) & (runtime.dword[0xA18] == 4)) {
                            runtime.dword[0xA2C] = 1;
                            runtime.dword[0xA10] = Stop_timer();
                            Update_minigame_record(0, 1, runtime.dword[0xA10]);
                            Make_operable(sora);
                            Make_party_invincible();
                            Enter_event_mode();
                            Command_display_off();
                            Gauge_off();
                            Set_wait_timer(1);
                            start(thread_2.entry_11, level=6);
                            DIALOG_STATE = 1;
                            Set_window_position(7, 0, 0);
                            Set_window_size(7, 8, 2);
                            Set_window_type(7, 6);
                            Set_window_opening_speed(7, 0);
                            Set_window_close_speed(7, 0);
                            Set_window_tail_type(7, 0);
                            Set_wait_timer(1);
                            Set_window_type(7, 1);
                            Open_window(7);
                            Display_message(7, messages[0x3A0]="{0x0A 00 00 00}{0x08}{lf}{0x0C 03}{0x0B 00 04 00}!{0x0B 00 04 00}!{0x0C FF} Finish {0x0C 03}{0x0B 00 04 00}!{0x0B 00 04 00}!");
                            Wait_message_end_ID(7);
                            start(thread_0.entry_12, level=5);
                            await(thread_0.entry_12, level=5);
                        }
                        break;
                    }
                }
            }
        }
    }

    thread 2 {
        main {
            while (1) {
            }
        }
        entry_11 {
            Start_resident_effect(3);
            Set_wait_timer(0xF);
            Start_resident_effect(0);
            Start_resident_effect(1);
            Start_resident_effect(2);
            Set_wait_timer(0xA);
            End_resident_effect_loop(3);
            End_resident_effect_loop(0);
            End_resident_effect_loop(1);
            End_resident_effect_loop(2);
        }
    }

    thread sora {  // 3
        init {
            Set_char_ID(SORA);
            Weapon_display_off();
        }
        main {
            while (1) {
            }
        }
        entry_11 {
            Set_char_initial_state(0x19F, -0x1CE, 0xB8);
            Turn_char(0xB4, 0);
            Wait_turn_end();
        }
    }

    thread player1 {  // 4
        init {
            Set_char_ID(PLAYER1);
        }
        main {
            while (1) {
            }
        }
    }

    thread player2 {  // 5
        init {
            Set_char_ID(PLAYER2);
        }
        main {
            while (1) {
