    thread sora {  // 1
        init {
            Set_char_ID(SORA_2);
            Set_char_position(0, 0, 0);
            Char_ctrl_off();
        }
        main {
            while (1) {
                runtime.dword[0x900] = Get_char_current_area();
                runtime.dword[0x904] = Check_Sora_on_ground();
                if (!((((runtime.dword[0x900] == 0x64) | (runtime.dword[0x900] == 0x65)) | (runtime.dword[0x900] == 0x66)) & (runtime.dword[0x904] == 1))) goto L1;
                if (DIVE_TO_THE_HEART_PROGRESS < 7) {
                    All_char_ctrl_off();
                    Fade_out(0xA);
                    Set_wait_timer(0xF);
                    runtime[0xC83] = runtime.dword[0x900];
                    Close_window(6);
                    Trigger_event(4);
                    goto L1;
                }
                if (!(DIVE_TO_THE_HEART_PROGRESS < 0xA)) goto L1;
                switch (runtime.dword[0x900]) {
                case 0x64:
                    if (save_data[0x100] != 0) {
                        All_char_ctrl_off();
                        Fade_out(0xA);
                        Set_wait_timer(0xF);
                        runtime[0xC84] = runtime.dword[0x900];
                        Trigger_event(5);
                    }
                    break;
                case 0x65:
                    if (save_data[0x100] != 1) {
                        All_char_ctrl_off();
                        Fade_out(0xA);
                        Set_wait_timer(0xF);
                        runtime[0xC84] = runtime.dword[0x900];
                        Trigger_event(5);
                    }
                    break;
                case 0x66:
                    if (save_data[0x100] != 2) {
                        All_char_ctrl_off();
                        Fade_out(0xA);
                        Set_wait_timer(0xF);
                        runtime[0xC84] = runtime.dword[0x900];
                        Trigger_event(5);
                    }
                    break;
                }
            L1:
            }
        }
    }

