            save_data2[0x3F6] = 0;
            save_data2[0x3F7] = 0;
            save_data2[0x1D] = 0;
            CURRENT_WORLD = Get_world_number();
            if ((bit[0x6B2F] == 1) | (bit[0x6B2E] == 0)) {
                DIALOG_STATE = 4;
            }
            bit[0x6B2E] = 1;
            bit[0x6B2F] = 0;
            Pad_ctrl_on();
            Enter_event_mode();
            Disable_battle_field_music_switch();
            No_BGM_load_on_map_change();
        }
        main {
            switch (save_data[0x326]) {
            case 0:
                Set_hercules_victory_flag(0);
                Trigger_event(1);
                break;
            case 1:
                Set_hercules_victory_flag(1);
                Trigger_event(4);
                break;
            case 2:
                Set_hercules_victory_flag(2);
                Trigger_event(2);
                break;
            case 3:
                Set_hercules_victory_flag(3);
                Trigger_event(3);
                break;
            }
            Get_camera_info();
            Set_wait_timer(4);
            Fade_in(8);
            Set_wait_timer(6);
            Command_display_on();
            Gauge_on();
            Pad_ctrl_on();
            All_char_ctrl_on();
            Remove_invincibility();
            Exit_event_mode();
            DIALOG_STATE = 0;
            Enable_all_battle_event_boxes();
            while (1) {
            }
        }
    }
}

