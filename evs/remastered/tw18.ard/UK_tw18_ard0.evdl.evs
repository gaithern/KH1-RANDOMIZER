    thread mo_pendulum {  // 20
        init {
            Set_char_ID(MO_PENDULUM);
            if (save_data2[0xBC] < 7) {
                TT_GIZMO_SHOP_SWITCHES = 0;
                Set_command_check_range(0);
            }
            local0 = 0;
        }
        main {
            while (1) {
                switch (TT_GIZMO_SHOP_SWITCHES) {
                case 0:
                    if (save_data2[0xBC] == 7) {
                        Play_SE2(0x2E, 0);
                        Set_wait_timer(0x12);
                        TT_GIZMO_SHOP_SWITCHES = 1;
                    }
                    break;
                case 3:
                    if (local0 == 0) {
                        Set_command_check_range(0xC8);
                        local0 = 1;
                    }
                    break;
                }
            }
        }
        on_action {
            local1 = Check_battle_or_normal_mode();
            if ((TT_GIZMO_SHOP_SWITCHES == 3) & (local1 == 0)) {
                Make_operable(sora);
                Make_party_invincible();
                Enter_event_mode();
                Command_display_off();
                Gauge_off();
                Set_wait_timer(1);
                if (DIALOG_STATE == 1) {
                    DIALOG_STATE = 2;
                    Close_window(7);
                }
                Set_window_size(7, 8, 2);
                Set_window_type(7, 6);
                Set_window_opening_speed(7, 0);
                Set_window_close_speed(7, 0);
                Set_window_tail_type(7, 0);
                Set_wait_timer(1);
                Set_window_width_auto(7, 0x3C3, -0xDC, -0x96);
                Open_window(7);
                Display_message(7, messages[0x3C3]="{0x08}{0x0A 00 00 00}{lf}The clock is stuck at 6:54.{0x06 2D 00}");
                Wait_message_end_ID(7);
                Close_window(7);
                if (DIALOG_STATE == 2) {
                    DIALOG_STATE = 3;
                }
                if (TT_GIZMO_SHOP_POSTCARD_2 == 0) {
                    if (DIALOG_STATE == 1) {
                        DIALOG_STATE = 2;
                        Close_window(7);
                    }
                    GIFT_TABLE_ITEM.dword = GIFT_TW_GIZMO_SHOP_POSTCARD_1;
                    Get_item_from_gift_table(GIFT_TABLE_ITEM.dword);
                    Set_window_size(7, 0, 1);
                    Set_window_type(7, 1);
                    Set_window_opening_speed(7, 0);
                    Set_window_close_speed(7, 0);
                    Set_window_tail_type(7, 0);
                    Scale_window_from_gift(7, GIFT_TABLE_ITEM.dword, -0xDC, -0x96);
                    Open_window(7);
                    Display_message_from_gift_table(7, GIFT_TABLE_ITEM.dword);
                    Set_wait_timer(8);
                    Play_SE2(0x1F, 0);
                    Wait_message_end_ID(7);
                    Close_window(7);
                    if (DIALOG_STATE == 2) {
                        DIALOG_STATE = 3;
                    }
                    Set_wait_timer(4);
                    if (DIALOG_STATE == 1) {
                        DIALOG_STATE = 2;
                        Close_window(7);
                    }
                    GIFT_TABLE_ITEM.dword = GIFT_TW_GIZMO_SHOP_POSTCARD_2;
                    Get_item_from_gift_table(GIFT_TABLE_ITEM.dword);
                    Set_window_size(7, 0, 1);
                    Set_window_type(7, 1);
                    Set_window_opening_speed(7, 0);
                    Set_window_close_speed(7, 0);
                    Set_window_tail_type(7, 0);
                    Scale_window_from_gift(7, GIFT_TABLE_ITEM.dword, -0xDC, -0x96);
                    Open_window(7);
                    Display_message_from_gift_table(7, GIFT_TABLE_ITEM.dword);
                    Set_wait_timer(8);
                    Play_SE2(0x1F, 0);
                    Wait_message_end_ID(7);
                    Close_window(7);
                    if (DIALOG_STATE == 2) {
                        DIALOG_STATE = 3;
                    }
                    TT_GIZMO_SHOP_POSTCARD_2 = 1;
                    TT_GIZMO_SHOP_POSTCARD_1 = 1;
                }
                Exit_event_mode();
                Gauge_on();
                Command_display_on();
                Remove_invincibility();
                Make_inoperable(sora);
            }
        }
    }

