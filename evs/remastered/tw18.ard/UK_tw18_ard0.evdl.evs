                        if (local1 == 1) {
                            start(mvf_thnd_switch.entry_11, level=5);
                            save_data2[0xBC] = save_data2[0xBC] | 4;
                            goto L4;
                        }
                        runtime.dword[0xA0C] = 0;
                    L4:
                        break;
                    }
                    local5 = runtime.dword[0xA0C];
