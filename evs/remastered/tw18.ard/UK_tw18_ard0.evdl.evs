                    save_data2.word[0x3EE] = Get_motion_number();
                    if ((0xA8 <= save_data2.word[0x3EE]) & (save_data2.word[0x3EE] <= 0xAE)) {
                        local1 = 1;
                        goto L1;
                    }
                    if (!((0xB2 <= save_data2.word[0x3EE]) & (save_data2.word[0x3EE] <= 0xBE))) goto L1;
                    local1 = 1;
                L1:
                    switch (runtime.dword[0xA0C]) {
                    case 0xB4:
                        if (!((save_data2[0xBC] & 1) == 0)) goto L2;
                        if (local1 == 1) {
                            start(mvf_fire_switch.entry_11, level=5);
                            save_data2[0xBC] = save_data2[0xBC] | 1;
                            goto L2;
                        }
                        runtime.dword[0xA0C] = 0;
                    L2:
                        break;
                    case 0xB5:
                        if (!((save_data2[0xBC] & 2) == 0)) goto L3;
                        if (local1 == 1) {
                            start(mvf_briz_switch.entry_11, level=5);
