globals {
    BLUE_TRINITY_LEARNED = bit[0x6AD8];
    CURRENT_WORLD = save_data2[0x1C];
    DIALOG_STATE = save_data2[3];
    GIFT_TABLE_ITEM = save_data2[0x3C4];
    GREEN_TRINITY_LEARNED = bit[0x6ADA];
    RED_TRINITY_LEARNED = bit[0x6AD9];
    TRAVERSE_TOWN_PROGRESS = save_data[0x904];
    TT_GEPPETTO_HOUSE_POSTCARD = bit[0x7003];
    WHITE_TRINITY_LEARNED = bit[0x6ADC];
    YELLOW_TRINITY_LEARNED = bit[0x6ADB];
    GIFT_TW_GEPPETTOS_HOUSE_POSTCARD = 0x30;
}

kgr 0 {
    entities {
        SORA = 0;
        PLAYER1 = 1;
        PLAYER2 = 2;
        MO_DR_8TW1 = 0x4001A;
        MO_KINGYO = 0x4001D;
        MO_TW13_HAGAKI = 0x40022;
    }

    thread 0 {
        init {
            Disable_all_battle_event_boxes();
            save_data2.word[0x3E0] = 0;
            save_data2.word[0x3E2] = 0;
            save_data2.word[0x3E4] = 0;
            save_data2.word[0x3E6] = 0;
            save_data2.word[0x3E8] = 0;
            save_data2.word[0x3EA] = 0;
            save_data2.word[0x3EC] = 0;
            save_data2.word[0x3EE] = 0;
            save_data2[0x3F0] = 0;
            save_data2[0x3F1] = 0;
            save_data2[0x3F2] = 0;
            save_data2[0x3F3] = 0;
            save_data2[0x3F4] = 0;
            save_data2[0x3F5] = 0;
            save_data2[0x3F6] = 0;
            save_data2[0x3F7] = 0;
            save_data2[0x1D] = 0;
            CURRENT_WORLD = Get_world_number();
            if ((bit[0x6B2F] == 1) | (bit[0x6B2E] == 0)) {
                DIALOG_STATE = 4;
            }
            bit[0x6B2E] = 1;
            bit[0x6B2F] = 0;
            Pad_ctrl_on();
            Enter_event_mode();
            Set_party(1, 2, -1);
        }
        main {
            Write_set_number(3, 0, 0xC);
            Write_set_number(3, 1, 0xC);
            Write_set_number(3, 2, 0xC);
            Write_set_number(3, 3, 0xC);
            Write_set_number(3, 4, 0xC);
            Write_set_number(3, 5, 0xC);
            Write_set_number(3, 6, 0xC);
            Write_set_number(3, 7, 0xC);
            Write_set_number(3, 8, 0xC);
            Write_set_number(3, 9, 0xC);
            Write_set_number(3, 0xA, 0xC);
            Write_set_number(3, 0xB, 0xC);
            Write_set_number(3, 0xC, 0xC);
            Write_set_number(3, 0xD, 0xC);
            Write_set_number(3, 0xE, 0xC);
            Write_set_number(3, 0xF, 0xC);
            Write_set_number(3, 0x10, 0xC);
            Write_set_number(3, 0x11, 0xC);
            Write_set_number(3, 0x12, 0xC);
            Write_set_number(3, 0x13, 0xC);
            Write_set_number(3, 0x14, 0xC);
            Write_set_number(3, 0x16, 0xC);
            Write_set_number(3, 0x18, 0xC);
            Write_set_number(3, 0x19, 0xC);
            TRAVERSE_TOWN_PROGRESS = 0x42;
            BLUE_TRINITY_LEARNED = 1;
            RED_TRINITY_LEARNED = 1;
            GREEN_TRINITY_LEARNED = 1;
            YELLOW_TRINITY_LEARNED = 1;
            WHITE_TRINITY_LEARNED = 1;
            Get_camera_info();
            Set_wait_timer(4);
            Fade_in(8);
            Set_wait_timer(6);
            Command_display_on();
            Gauge_on();
            Pad_ctrl_on();
            All_char_ctrl_on();
            Remove_invincibility();
            Exit_event_mode();
            DIALOG_STATE = 0;
            Enable_all_battle_event_boxes();
            while (1) {
            }
        }
    }

    thread sora {  // 1
        init {
            Set_char_ID(SORA);
        }
        main {
            while (1) {
            }
        }
    }

    thread player1 {  // 2
        init {
            Set_char_ID(PLAYER1);
        }
        main {
            while (1) {
            }
        }
    }

    thread player2 {  // 3
        init {
            Set_char_ID(PLAYER2);
        }
        main {
            while (1) {
            }
        }
    }

    thread 4 {
        init {
            All_char_ctrl_off();
            Make_party_invincible();
        }
        main {
            while (1) {
            }
        }
    }

    thread mo_tw13_hagaki {  // 5
        init {
            Set_char_ID(MO_TW13_HAGAKI);
            Set_char_position(0x162, -0x6C, 0x168);
            if (TT_GEPPETTO_HOUSE_POSTCARD == 0) {
                Set_command_check_range(0xC8);
            } else {
                Set_command_check_range(0);
                Disable_targeting();
            }
        }
        main {
            while (1) {
                if (TT_GEPPETTO_HOUSE_POSTCARD == 1) {
                    Set_command_check_range(0);
                    Disable_targeting();
                }
            }
        }
        on_action {
            if (TT_GEPPETTO_HOUSE_POSTCARD == 0) {
                Make_operable(sora);
                Make_party_invincible();
                Enter_event_mode();
                Command_display_off();
                Gauge_off();
                Set_wait_timer(1);
                Set_command_check_range(0);
                TT_GEPPETTO_HOUSE_POSTCARD = 1;
                if (DIALOG_STATE == 1) {
                    DIALOG_STATE = 2;
                    Close_window(7);
                }
                GIFT_TABLE_ITEM.dword = GIFT_TW_GEPPETTOS_HOUSE_POSTCARD;
                Get_item_from_gift_table(GIFT_TABLE_ITEM.dword);
                Set_window_size(7, 0, 1);
                Set_window_type(7, 1);
                Set_window_opening_speed(7, 0);
                Set_window_close_speed(7, 0);
                Set_window_tail_type(7, 0);
                Scale_window_from_gift(7, GIFT_TABLE_ITEM.dword, -0xDC, -0x96);
                Open_window(7);
                Display_message_from_gift_table(7, GIFT_TABLE_ITEM.dword);
                Set_wait_timer(8);
                Play_SE2(0x1F, 0);
                Wait_message_end_ID(7);
                Close_window(7);
                if (DIALOG_STATE == 2) {
                    DIALOG_STATE = 3;
                }
                Exit_event_mode();
                Gauge_on();
                Command_display_on();
                Remove_invincibility();
                Make_inoperable(sora);
            }
        }
    }

    thread mo_kingyo {  // 6
        init {
            Set_char_ID(MO_KINGYO);
            Set_char_position(Push_actor_coord_X(mo_kingyo), Push_actor_coord_Y(mo_kingyo), Push_actor_coord_Z(mo_kingyo) - 3);
        }
        main {
            while (1) {
                local17 = Random_value(0x24);
                Set_wait_timer(local17 * 0x1E);
                ROT(0x1E, 0, local17 * 0xA, 0);
                Set_wait_timer(0x1E);
            }
        }
    }

    thread mo_dr_8tw1 {  // 7
        init {
            Set_char_ID(MO_DR_8TW1);
            local18 = 0;
            local19 = 0;
            local20 = 0;
            local21 = 0;
            local22 = 0;
            local23 = 0;
            local24 = 0;
            local25 = 0;
        }
        main {
            local18 = 0;
            local19 = 0;
            while (1) {
                if (!(DIALOG_STATE != 4)) goto L1;
                Set_wait_timer(1);
                local20 = GetLength_2(-0x1EC, -0x183, Push_actor_coord_X2(0), Push_actor_coord_Z2(0));
                if (((local20 < 0x96) & (Push_actor_coord_Y2(0) <= 0x64)) & (Push_actor_coord_Y2(0) > (0 + -0x12C))) {
                    local18 = 1;
                } else {
                    local18 = 0;
                }
                if ((local18 != 0) & (local19 == 0)) {
                    local19 = 1;
                    DIALOG_STATE = 1;
                    Set_window_size(7, 6, 0);
                    Set_window_type(7, 0);
                    Set_window_opening_speed(7, 0);
                    Set_window_close_speed(7, 0);
                    Set_window_tail_type(7, 0);
                    Set_window_position(7, 0, 0x96);
                    Close_window(7);
                    Open_window_no_close(7);
                    Display_message(7, messages[0x37F]="{0x08}{0x0A 00 00 00}First District");
                    goto L2;
                }
                if (!((local18 == 0) & (local19 == 1))) goto L2;
                Close_window(7);
                DIALOG_STATE = 0;
                local19 = 0;
            L2:
                if (!(DIALOG_STATE == 3)) goto L1;
                local19 = 0;
            L1:
            }
        }
    }
}
