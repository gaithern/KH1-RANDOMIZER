        entry_11 {
            Collision_off();
            Weapon_display_off();
            Change_motion(0);
            local1 = Call_cos(0);
            local2 = Call_sin(0);
            local5 = ((0 * local1) - (0x50 * local2)) / 0x2710;
            local6 = ((0 * local2) + (0x50 * local1)) / 0x2710;
            Set_char_initial_state(EVENT_POSITION_X.word + local5, EVENT_POSITION_Y.word, EVENT_POSITION_Z.word - local6);
            Collision_off();
            Set_wait_timer(1);
            Turn_to_position(EVENT_POSITION_X.word, EVENT_POSITION_Y.word, EVENT_POSITION_Z.word, 0);
            Wait_turn_end();
        }
        entry_12 {
            local0 = 0;
            switch (local0) {
            case 0:
                Turn_head_coords(EVENT_POSITION_X.word, EVENT_POSITION_Y.word, EVENT_POSITION_Z.word, 0);
                Set_wait_timer(1);
                Restore_head(8);
                break;
            case 1:
                Turn_head_coords(Push_actor_coord_X(sora), Push_actor_coord_Y(sora) - 0x28, Push_actor_coord_Z(sora), 8);
                break;
            case 2:
                Turn_head_coords(Push_actor_coord_X(sora), Push_actor_coord_Y(sora) - 0x28, Push_actor_coord_Z(sora), 0xC);
                break;
            }
        }
        entry_13 {
            local0 = Push_actor_rotation(sora);
            if (local0 < 0) {
                local0 = 0x168 + local0;
            }
            local0 = (local0 + 0xB4) % 0x168;
            local1 = Call_cos(local0);
