            local5 = ((0 * local1) - (0x96 * local2)) / 0x2710;
            local6 = ((0 * local2) + (0x96 * local1)) / 0x2710;
            Set_camera_focus_position(Push_actor_coord_X(sora), Push_actor_coord_Y(sora) - 0x7D, Push_actor_coord_Z(sora));
            Set_camera_position(Push_actor_coord_X(sora) + local5, Push_actor_coord_Y(sora) - 0x7D, Push_actor_coord_Z(sora) - local6);
            Set_camera_fov(0x1A);
        }
        entry_14 {
            Restore_head(0);
            Motion_ctrl_off();
            Set_event_motion(1, 0);
            Motion_change_no_loop(0xC8);
            Set_wait_timer(0x24);
        }
