            save_data2[0x3F3] = 0;
            save_data2[0x3F4] = 0;
            save_data2[0x3F5] = 0;
            save_data2[0x3F6] = 0;
            save_data2[0x3F7] = 0;
            save_data2[0x1D] = 0;
            CURRENT_WORLD = Get_world_number();
            if ((bit[0x6B2F] == 1) | (bit[0x6B2E] == 0)) {
                DIALOG_STATE = 4;
            }
            bit[0x6B2E] = 1;
            bit[0x6B2F] = 0;
            Pad_ctrl_on();
            Enter_event_mode();
            runtime.dword[0xA0C] = 0;
            runtime.dword[0xA10] = 0;
            runtime.dword[0xA14] = 1;
            runtime.dword[0xA18] = 1;
            runtime.dword[0xA1C] = 0;
            runtime.dword[0xA20] = -1;
            runtime.dword[0xA30] = 0;
            runtime.dword[0xA38] = 0;
            runtime.dword[0xA3C] = 0;
            runtime.dword[0xA40] = 0;
            runtime.dword[0xA44] = 0;
            runtime.dword[0xA48] = 0;
            runtime.dword[0xA4C] = 0;
            runtime.dword[0xA50] = 0;
            runtime.dword[0xA54] = 0;
            runtime.dword[0xA58] = 0;
            runtime.dword[0xA5C] = 0;
            runtime.dword[0xA60] = 0;
            runtime.dword[0xA64] = 0;
        }
    }

