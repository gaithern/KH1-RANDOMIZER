                All_char_ctrl_on();
                Remove_invincibility();
                Exit_event_mode();
                DIALOG_STATE = 0;
                Enable_all_battle_event_boxes();
                bit[0x7D13] = 0;
                goto L1;
            }
            Get_camera_info();
            Set_wait_timer(4);
            Fade_in(8);
            Set_wait_timer(6);
            Command_display_on();
            Gauge_on();
            Pad_ctrl_on();
            All_char_ctrl_on();
            Remove_invincibility();
            Exit_event_mode();
            DIALOG_STATE = 0;
            Enable_all_battle_event_boxes();
        L1:
