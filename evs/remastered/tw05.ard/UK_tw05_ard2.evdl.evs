globals {
    CURRENT_WORLD = save_data2[0x1C];
    DIALOG_STATE = save_data2[3];
    PREVIOUS_AREA = save_data2[1];
    PREVIOUS_SET = save_data2[2];
    PREVIOUS_WORLD = save_data2[0];
    TRAVERSE_TOWN_PROGRESS = save_data[0x904];
    TW05_RED_TRINITY_DONE = bit[0x6D6F];
}

kgr 0 {
    entities {
        SORA_2 = 0x30000;
    }

    thread 0 {
        init {
            Disable_all_battle_event_boxes();
            save_data2.word[0x3E0] = 0;
            save_data2.word[0x3E2] = 0;
            save_data2.word[0x3E4] = 0;
            save_data2.word[0x3E6] = 0;
            save_data2.word[0x3E8] = 0;
            save_data2.word[0x3EA] = 0;
            save_data2.word[0x3EC] = 0;
            save_data2.word[0x3EE] = 0;
            save_data2[0x3F0] = 0;
            save_data2[0x3F1] = 0;
            save_data2[0x3F2] = 0;
            save_data2[0x3F3] = 0;
            save_data2[0x3F4] = 0;
            save_data2[0x3F5] = 0;
            save_data2[0x3F6] = 0;
            save_data2[0x3F7] = 0;
            save_data2[0x1D] = 0;
            CURRENT_WORLD = Get_world_number();
            if ((bit[0x6B2F] == 1) | (bit[0x6B2E] == 0)) {
                DIALOG_STATE = 4;
            }
            bit[0x6B2E] = 1;
            bit[0x6B2F] = 0;
            Pad_ctrl_on();
            Enter_event_mode();
            if (TW05_RED_TRINITY_DONE == 1) {
                Set_attribute_off(0xBE);
            }
            Stop_BGM();
            Quick_save_on();
        }
        main {
            if (!(TRAVERSE_TOWN_PROGRESS == 0x1A)) goto L1;
            Hold_camera_info();
            Make_operable(sora);
            Make_party_invincible();
            Enter_event_mode();
            Command_display_off();
            Gauge_off();
            Set_wait_timer(1);
            PREVIOUS_WORLD = Get_world_number();
            runtime[0xD0F] = PREVIOUS_AREA;
            PREVIOUS_AREA = Get_area_number();
            PREVIOUS_SET = Get_set_number();
            DIALOG_STATE = 2;
            Close_window(7);
            Pad_ctrl_on();
            Trigger_event(1);
            Write_set_number_from_table(5);
            Pad_ctrl_off();
            Enter_event_mode();
            Fade_out(0x3C);
            Set_wait_timer(0x3C);
            DIALOG_STATE = 3;
            bit[0x6B2F] = 1;
            bit[0x6B2E] = 1;
            Event_camera_off();
            Change_area(0x26);
        L1:
            if (1) {
                goto L1;
            }
        }
    }

    thread sora {  // 1
        init {
            Set_char_ID(SORA_2);
            Char_ctrl_off();
            Motion_ctrl_off();
            Collision_off();
            Char_bg_off();
            Disable_targeting();
            Hide_char();
            Hide_char_shadow();
            Disable_targeting();
        }
        main {
            while (1) {
            }
        }
    }
}

