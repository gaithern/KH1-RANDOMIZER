            Move_camera_fov(0x1E, 0x14);
            Set_wait_timer(0x14);
            Save_crossfade_image();
            Start_crossfade(6);
            Set_camera_position(save_data2.word[6], EVENT_POSITION_Y.word, save_data2.word[0xA]);
            Set_wait_timer(0x1E);
            Set_window_size(7, 5, 2);
            Set_window_tail_location(7, 0xB);
            Set_window_tail_rotation(7, 0xA0);
            Set_window_position(7, 0x96, 0x64);
            Open_window(7);
            Display_message(7, messages[0x3C5]="{0x07 0C 00}I wonder what{lf}it is.");
            Wait_message_end_ID(7);
            Set_window_type(7, 1);
            Set_window_tail_type(7, 0);
            Set_window_opening_speed(7, 0);
            Set_window_close_speed(7, 0);
            Set_message_display_speed(7, 0);
            Set_window_size(7, 0xA, 3);
            Set_window_position(7, 0, -0x64);
            Open_window(7);
            Display_message(7, messages[0x3C6]="{0x0A 00 00 00}This is a Trinity Mark.{lf}They appear in many places.{lf}Only the blue ones react{lf}in the beginning.");
            Wait_message_end_ID(7);
            Open_window(7);
            Display_message(7, messages[0x3C7]="{0x0A 00 00 00}{0x07 0C 00}Sora, Donald, and Goofy{lf}can perform various Trinity{lf}Moves beside these marks.");
            Wait_message_end_ID(7);
            start(player1.entry_26, level=6);
            await(player1.entry_26, level=6);
            start(player1.entry_13, level=6);
            await(player1.entry_13, level=6);
            Set_wait_timer(0x14);
            start(sora.entry_26, level=6);
            await(sora.entry_26, level=6);
            start(sora.entry_13, level=6);
            await(sora.entry_13, level=6);
            Set_wait_timer(0x14);
            Fade_out(0xA);
            Set_wait_timer(0xA);
            Restore_camera_default(2, 1);
            BLUE_TRINITY_LEARNED = 1;
            start(sora.entry_29, level=6);
            await(sora.entry_29, level=6);
            start(player1.entry_29, level=6);
            await(player1.entry_29, level=6);
            start(player2.entry_30, level=6);
            await(player2.entry_30, level=6);
            All_char_ctrl_on();
            Set_wait_timer(4);
            Event_camera_off();
        }
    }
}
