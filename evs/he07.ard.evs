kgr 0 {
    entities {
        HADES = 0x30003;
    }

    thread 0 {
        init {
            Disable_all_battle_event_boxes();
            save_data2.word[0x3E0] = 0;
            save_data2.word[0x3E2] = 0;
            save_data2.word[0x3E4] = 0;
            save_data2.word[0x3E6] = 0;
            save_data2.word[0x3E8] = 0;
            save_data2.word[0x3EA] = 0;
            save_data2.word[0x3EC] = 0;
            save_data2.word[0x3EE] = 0;
            save_data2[0x3F0] = 0;
            save_data2[0x3F1] = 0;
            save_data2[0x3F2] = 0;
            save_data2[0x3F3] = 0;
            save_data2[0x3F4] = 0;
            save_data2[0x3F5] = 0;
            save_data2[0x3F6] = 0;
            save_data2[0x3F7] = 0;
            save_data2[0x1D] = 0;
            CURRENT_WORLD = Get_world_number();
            if ((bit[0x6B2F] == 1) | (bit[0x6B2E] == 0)) {
                DIALOG_STATE = 4;
            }
            bit[0x6B2E] = 1;
            bit[0x6B2F] = 0;
            Pad_ctrl_on();
            Enter_event_mode();
            save_data[0x300] = 1;
        }
        main {
            Get_camera_info();
            Set_wait_timer(4);
            Fade_in(8);
            Set_wait_timer(6);
            Command_display_on();
            Gauge_on();
            Pad_ctrl_on();
            All_char_ctrl_on();
            Remove_invincibility();
            Exit_event_mode();
            DIALOG_STATE = 0;
            Enable_all_battle_event_boxes();
            Discard_object_data(HADES);
            if (save_data[0x300] == 1) {
                Trigger_event(1);
            }
            if (!(save_data[0x300] == 2)) goto L1;
            Trigger_event(2);
        L1:
            if (1) {
                local0 = Get_comm_ID();
                local1 = Get_comm_Num();
                Display_register_value(local0);
                Display_register_value(local1);
                if ((local0 == 0x64) & (local1 == 1)) {
                    Change_BGM_volume(1, 0, 0x14);
                    Change_BGM_volume(2, 0, 0x14);
                    Set_wait_timer(0x14);
                    Stop_BGM();
                    Trigger_event(2);
                }
                goto L1;
            }
        }
    }
}

