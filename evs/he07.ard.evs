            Turn_char(0, 0);
            switch (runtime.dword[0x954]) {
            case 0:
                Motion_ctrl_off();
                Set_event_motion(1, 0);
                Weapon_display_off();
                Change_motion(0xCB);
                Play_partial_motion(0x5A, 0x78, 0);
                Play_voice(0xA, 0x64, 0x64);
                Wait_voice_finish(0xA);
