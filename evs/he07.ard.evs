            Enter_event_mode();
            Command_display_off();
            Gauge_off();
            Set_wait_timer(1);
            PREVIOUS_WORLD = Get_world_number();
            runtime[0xD00] = PREVIOUS_AREA;
            PREVIOUS_AREA = Get_area_number();
            PREVIOUS_SET = Get_set_number();
            DIALOG_STATE = 2;
            Close_window(7);
            Pad_ctrl_off();
            Set_wait_timer(1);
            if (-1 != -1) {
                Load_next_map_texture(-1);
            }
            Fade_out(0x1E);
            Set_wait_timer(0x1E);
            start(sora.entry_13, level=5);
            await(sora.entry_13, level=5);
            End_minigame();
            Minigame_limit_off();
            if (DIALOG_STATE == 2) {
                DIALOG_STATE = 3;
