    entities {
        SORA_2 = 0x30000;
    }

    thread 0 {
        init {
            Gauge_off();
            Command_display_off();
            runtime.dword[0x954] = Random_value(1);
            Enter_event_mode();
            Enable_summon_command();
        }
        main {
            save_data[0x30F] = 0;
            save_data[0x312] = 1;
            Enemy_ctrl_off();
            Enemy_bg_impact_off();
            All_char_ctrl_off();
            Disable_all_battle_event_boxes();
            start(sora.entry_11, level=5);
            Change_game_speed(0xA);
            Blur_on();
            Move_camera_fov(0x27, 0x28);
            Set_wait_timer(3);
            Fade_out(1);
            Set_wait_timer(1);
            await(sora.entry_11, level=5);
            Init_all_enemy_battle_scripts();
            Set_wait_timer(1);
            Erase_all_enemies();
            Event_camera_on();
            Load_voice(6, 0x32);
            Wait_voice_load();
            Load_event_motion(1, 0x1E);
            Wait_file_load(1);
            Play_camera_motion(0x29);
            Change_game_speed(0x64);
            Blur_off();
            Fade_in(0xA);
            start(sora.entry_12, level=5);
