                        Change_motion(7);
                        Set_wait_timer(6);
                        Change_motion_interp(2, 8);
                        Move_smooth_rot(7, 0x1575, -0x4DF, -0xB54);
                        runtime.dword[0xA10] = 1;
                    }
                    runtime.dword[0xA34] = runtime.dword[0xA34] - 1;
                    if (runtime.dword[0xA34] <= 0) {
                        runtime.dword[0xA10] = 1;
                    }
                    Set_wait_timer(1);
                }
                Set_wait_timer(runtime.dword[0xA34]);
                Set_attribute_on(0x8D);
                bit[0x6B2F] = 1;
                bit[0x6B2E] = 1;
                Event_camera_off();
                Change_area(0x28);
            }
        }
    }
}
